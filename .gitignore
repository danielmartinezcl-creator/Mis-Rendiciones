# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# archivos de prueba y referencia locales
nomina-ejemplo.xlsx
importador-comprobantes.xlsx
Centros de Costos.xlsx
Plan de Cuentas.xls
Rendiciones ejemplos/
Mi rendición — Design System/
Manual de usuario*

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Playwright — línea base visual (etapa 0 Tornasol)
# e2e/baseline/ SÍ se commitea: es la referencia contra la que compara la etapa 1
/e2e/reporte/
/e2e/.auth/
/test-results/
/playwright-report/
# Capturas de referencia de pantallas no deterministas: se miran, no se comparan
/e2e/referencia/

# Informe generado por 'npm run audit:materiales' — se regenera en cada corrida
e2e/reporte-materiales.md

# Scripts descartables de sesiones de trabajo — no son del proyecto.
*-tmp.mjs
*-tmp.json
*-tmp.png
